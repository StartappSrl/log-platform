worker_processes auto;

events { worker_connections 1024; }

http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    client_max_body_size 20m;

    upstream auth_upstream    { server ${AUTH_HOST}:${AUTH_PORT}; }

    server {
        absolute_redirect off;

        listen 8080;
        server_name _;

        location = /login.html {
            root /usr/share/nginx/html;
        }

        location = /startapp-logo.png {
            root /usr/share/nginx/html;
        }

        location = /defendia-logo.png {
            root /usr/share/nginx/html;
        }

        location /_authgate/ {
            proxy_pass http://auth_upstream/_authgate/;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Host $host;
        }

        location = /auth-check-internal {
            internal;
            proxy_pass http://auth_upstream/_authgate/auth_check;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header X-Real-IP $remote_addr;
        }

        location = / {
            return 302 /dashboard.html;
        }

        location / {
            auth_request /auth-check-internal;
            error_page 401 = @login_redirect;

            auth_request_set $auth_user $upstream_http_x_auth_user;
            proxy_set_header X-Auth-User $auth_user;

            proxy_pass http://auth_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location @login_redirect {
            return 302 /login.html;
        }
    }
}
