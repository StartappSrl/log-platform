<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<title>Log Platform — Pannello</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  * { box-sizing: border-box; }
  body { font-family: -apple-system, Segoe UI, Arial, sans-serif; background:#f8fafc; color:#1e293b; margin:0; }
  header { display:flex; align-items:center; justify-content:space-between; padding:1rem 1.5rem;
           background:#ffffff; border-bottom:1px solid #e2e8f0; }
  header h1 { font-size:1.1rem; margin:0; }
  .who { font-size:.85rem; color:#64748b; }
  .badge { background:#e2e8f0; color:#1e293b; padding:.15rem .5rem; border-radius:4px; margin-left:.5rem; }
  button.logout { background:transparent; border:1px solid #cbd5e1; color:#1e293b; padding:.4rem .8rem;
                  border-radius:6px; cursor:pointer; }
  nav { display:flex; gap:.25rem; padding:0 1.5rem; background:#ffffff; border-bottom:1px solid #e2e8f0; }
  nav button { background:transparent; border:none; color:#64748b; padding:.8rem 1rem; cursor:pointer;
               font-size:.9rem; border-bottom:2px solid transparent; }
  nav button.active { color:#1e293b; border-bottom-color:#3b82f6; }
  main { padding:1.5rem; max-width:1000px; margin:0 auto; }
  .panel { display:none; }
  .panel.active { display:block; }
  .row { display:flex; gap:.75rem; align-items:end; flex-wrap:wrap; margin-bottom:1rem; }
  label { display:block; font-size:.8rem; color:#64748b; margin-bottom:.25rem; }
  input, select { padding:.5rem; border-radius:6px; border:1px solid #cbd5e1; background:#ffffff;
                  color:#1e293b; font-size:.9rem; }
  button.primary { background:#3b82f6; border:none; color:white; padding:.55rem 1.1rem; border-radius:6px;
                   cursor:pointer; font-weight:600; }
  button.primary:hover { background:#2563eb; }
  table { width:100%; border-collapse:collapse; margin-top:1rem; font-size:.85rem; }
  th, td { text-align:left; padding:.5rem .6rem; border-bottom:1px solid #e2e8f0; }
  th { color:#64748b; font-weight:600; }
  .msg-cell { max-width:500px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .error-box { background:#fee2e2; color:#991b1b; padding:.6rem 1rem; border-radius:6px; margin-bottom:1rem;
               font-size:.85rem; }
  .empty { color:#94a3b8; font-style:italic; padding:1rem 0; }
  .card-form { background:#ffffff; border:1px solid #e2e8f0; padding:1rem; border-radius:8px; margin-bottom:1.5rem; }
  .card-form h3 { margin-top:0; font-size:.95rem; }
  .checkbox-row { display:flex; align-items:center; gap:.4rem; font-size:.85rem; color:#475569; }
</style>
</head>
<body>

<header>
  <h1>Log Platform</h1>
  <div class="who">
    <span id="who-username"></span>
    <span class="badge" id="who-tenant"></span>
    <button class="logout" onclick="logout()">Esci</button>
  </div>
</header>

<nav>
  <button data-panel="clienti" id="nav-clienti" onclick="showPanel('clienti')">Clienti</button>
  <button data-panel="ricerca" onclick="showPanel('ricerca')">Ricerca</button>
  <button data-panel="allarmi" onclick="showPanel('allarmi')">Allarmi</button>
  <button data-panel="notifiche" onclick="showPanel('notifiche')">Notifiche</button>
  <button data-panel="inventario" onclick="showPanel('inventario')">Inventario</button>
  <button data-panel="certificati" onclick="showPanel('certificati')">Certificati</button>
</nav>

<main>
  <div id="global-error"></div>

  <!-- CLIENTI (solo admin) -->
  <section class="panel" id="panel-clienti">
    <div class="card-form">
      <h3>Nuovo cliente</h3>
      <div class="row">
        <div>
          <label>Identificativo (solo lettere/numeri/trattini)</label>
          <input id="new-tenant-name" placeholder="es. acme">
        </div>
        <div>
          <label>Nome visualizzato</label>
          <input id="new-tenant-display" placeholder="es. ACME Srl">
        </div>
        <div>
          <label>Conservazione (giorni)</label>
          <input id="new-tenant-retention" type="number" value="90" style="width:90px">
        </div>
        <button class="primary" onclick="createTenant()">Crea cliente</button>
      </div>
    </div>
    <table id="tenants-table">
      <thead><tr><th>Identificativo</th><th>Nome</th><th>Stream Graylog</th><th>Agent</th></tr></thead>
      <tbody></tbody>
    </table>
    <div class="empty" id="tenants-empty" style="display:none">Nessun cliente ancora. Creane uno sopra.</div>
  </section>

  <!-- RICERCA -->
  <section class="panel" id="panel-ricerca">
    <div class="row">
      <div id="ricerca-tenant-wrap">
        <label>Cliente</label>
        <select id="ricerca-tenant"></select>
      </div>
      <div>
        <label>Ricerca (testo libero, * per tutto)</label>
        <input id="ricerca-query" value="*" style="width:280px">
      </div>
      <div>
        <label>Periodo</label>
        <select id="ricerca-range">
          <option value="15">Ultimi 15 minuti</option>
          <option value="60" selected>Ultima ora</option>
          <option value="1440">Ultime 24 ore</option>
          <option value="10080">Ultimi 7 giorni</option>
        </select>
      </div>
      <button class="primary" onclick="runSearch()">Cerca</button>
    </div>
    <table id="search-table">
      <thead><tr><th>Data/ora</th><th>Host</th><th>Messaggio</th></tr></thead>
      <tbody></tbody>
    </table>
    <div class="empty" id="search-empty" style="display:none">Nessun risultato per questa ricerca.</div>
  </section>

  <!-- ALLARMI -->
  <section class="panel" id="panel-allarmi">
    <div class="card-form">
      <h3>Nuovo allarme</h3>
      <div class="row">
        <div id="allarme-tenant-wrap">
          <label>Cliente</label>
          <select id="allarme-tenant"></select>
        </div>
        <div>
          <label>Titolo</label>
          <input id="allarme-titolo" placeholder="es. Troppi errori 500">
        </div>
        <div>
          <label>Ricerca da monitorare</label>
          <input id="allarme-query" value="*" style="width:220px">
        </div>
        <div>
          <label>Soglia (numero messaggi)</label>
          <input id="allarme-soglia" type="number" value="10" style="width:100px">
        </div>
        <div>
          <label>Nella finestra di (minuti)</label>
          <input id="allarme-finestra" type="number" value="5" style="width:100px">
        </div>
      </div>
      <div id="allarme-notifiche-list" style="margin-bottom:.75rem"></div>
      <button class="primary" onclick="createAlarm()">Crea allarme</button>
    </div>
    <table id="alarms-table">
      <thead><tr><th>Titolo</th><th>Ricerca</th></tr></thead>
      <tbody></tbody>
    </table>
    <div class="empty" id="alarms-empty" style="display:none">Nessun allarme configurato per questo cliente.</div>
  </section>

  <!-- NOTIFICHE -->
  <section class="panel" id="panel-notifiche">
    <div class="card-form">
      <h3>Nuova notifica</h3>
      <div class="row">
        <div id="notifica-tenant-wrap">
          <label>Cliente</label>
          <select id="notifica-tenant"></select>
        </div>
        <div>
          <label>Nome</label>
          <input id="notifica-nome" placeholder="es. Email IT">
        </div>
        <div>
          <label>Tipo</label>
          <select id="notifica-tipo">
            <option value="email">Email</option>
            <option value="webhook">Webhook (Slack/Teams/altro)</option>
          </select>
        </div>
        <div>
          <label>Destinazione</label>
          <input id="notifica-target" placeholder="email@esempio.it oppure https://..." style="width:280px">
        </div>
        <button class="primary" onclick="createNotification()">Crea notifica</button>
      </div>
    </div>
    <table id="notifications-table">
      <thead><tr><th>Titolo</th><th>Tipo</th></tr></thead>
      <tbody></tbody>
    </table>
    <div class="empty" id="notifications-empty" style="display:none">Nessuna notifica configurata.</div>
  </section>

  <section class="panel" id="panel-inventario">
    <div class="row">
      <div id="inventario-tenant-wrap">
        <label>Cliente</label>
        <select id="inventario-tenant"></select>
      </div>
      <button class="primary" onclick="loadInventory()">Aggiorna</button>
    </div>
    <table id="inventory-table">
      <thead><tr>
        <th>Host</th><th>Sistema operativo</th><th>CPU</th><th>RAM</th>
        <th>Disco (usato/totale)</th><th>Software</th><th>Ultimo aggiornamento</th><th>Esporta</th>
      </tr></thead>
      <tbody></tbody>
    </table>
    <div class="empty" id="inventory-empty" style="display:none">Nessun inventario ricevuto ancora per questo cliente (arriva entro 24 ore dal primo avvio dell'agent).</div>

    <div id="inventory-software-detail" style="display:none; margin-top:1.5rem">
      <h3 id="inventory-software-title" style="font-size:.95rem"></h3>
      <table id="inventory-software-table">
        <thead><tr><th>Pacchetto</th><th>Versione</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
  </section>


  <section class="panel" id="panel-certificati">
    <div class="row">
      <a href="/_authgate/dashboard/certificates/crl" class="primary" style="text-decoration:none;padding:.4em 1em;border-radius:4px">Scarica CRL</a>
      <button onclick="loadCertificates()">Aggiorna</button>
    </div>
    <table id="certificates-table">
      <thead><tr>
        <th>Nome</th><th>Tipo</th><th>Emesso il</th><th>Stato</th><th>Azione</th>
      </tr></thead>
      <tbody></tbody>
    </table>
    <div class="empty" id="certificates-empty" style="display:none">Nessun certificato emesso ancora.</div>
  </section>

</main>

<script>
let ME = null; // {username, tenant, is_admin}

function showError(msg) {
  const box = document.getElementById('global-error');
  box.innerHTML = msg ? `<div class="error-box">${msg}</div>` : '';
}

let _csrfToken = null;

async function _ensureCsrfToken() {
  if (_csrfToken) return _csrfToken;
  const resp = await fetch('/_authgate/dashboard/csrf-token');
  if (resp.ok) {
    const data = await resp.json();
    _csrfToken = data.csrf_token;
  }
  return _csrfToken;
}

async function api(path, opts = {}) {
  const method = (opts.method || 'GET').toUpperCase();
  let headers = { 'Content-Type': 'application/json', ...(opts.headers || {}) };
  if (method !== 'GET') {
    const token = await _ensureCsrfToken();
    headers = { ...headers, 'X-CSRF-Token': token || '' };
  }
  const res = await fetch(path, { ...opts, headers });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || `Errore ${res.status}`);
  return data;
}

function logout() {
  api('/_authgate/logout', { method: 'POST' }).finally(() => { window.location.href = '/login.html'; });
}

function showPanel(name) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('nav button').forEach(b => b.classList.remove('active'));
  document.getElementById('panel-' + name).classList.add('active');
  document.querySelector(`nav button[data-panel="${name}"]`).classList.add('active');
  showError('');
  if (name === 'clienti') loadTenants();
  if (name === 'ricerca') loadTenantOptions('ricerca-tenant');
  if (name === 'allarmi') { loadTenantOptions('allarme-tenant'); loadNotificationsForCheckboxes(); loadAlarms(); }
  if (name === 'notifiche') { loadTenantOptions('notifica-tenant'); loadNotifications(); }
  if (name === 'inventario') { loadTenantOptions('inventario-tenant').then(loadInventory); }
  if (name === 'certificati') { loadCertificates(); }
}

// --- Chi sono ---
async function loadWhoAmI() {
  ME = await api('/_authgate/dashboard/whoami');
  document.getElementById('who-username').textContent = ME.username;
  document.getElementById('who-tenant').textContent = ME.is_admin ? 'amministratore' : ME.tenant;
  if (!ME.is_admin) {
    document.getElementById('nav-clienti').style.display = 'none';
    showPanel('ricerca');
  } else {
    showPanel('clienti');
  }
}

// --- Selettore tenant riusabile: admin vede tutti, cliente vede solo il proprio (bloccato) ---
async function loadTenantOptions(selectId) {
  const sel = document.getElementById(selectId);
  sel.innerHTML = '';
  if (!ME.is_admin) {
    const opt = document.createElement('option');
    opt.value = ME.tenant; opt.textContent = ME.tenant;
    sel.appendChild(opt);
    sel.disabled = true;
    return;
  }
  sel.disabled = false;
  try {
    const tenants = await api('/_authgate/dashboard/tenants');
    tenants.forEach(t => {
      const opt = document.createElement('option');
      opt.value = t.name; opt.textContent = t.display_name || t.name;
      sel.appendChild(opt);
    });
  } catch (e) { showError(e.message); }
}

// --- Clienti ---
async function loadTenants() {
  try {
    const tenants = await api('/_authgate/dashboard/tenants');
    const tbody = document.querySelector('#tenants-table tbody');
    tbody.innerHTML = '';
    document.getElementById('tenants-empty').style.display = tenants.length ? 'none' : 'block';
    tenants.forEach(t => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${t.name}</td><td>${t.display_name || ''}</td><td>${t.stream_id || ''}</td><td><a href="/_authgate/dashboard/tenants/${t.name}/agent-package">Linux/config</a> | <a href="/_authgate/dashboard/tenants/${t.name}/agent-package-windows">Windows .exe</a></td>`;
      tbody.appendChild(tr);
    });
  } catch (e) { showError(e.message); }
}

async function createTenant() {
  const name = document.getElementById('new-tenant-name').value.trim();
  const display_name = document.getElementById('new-tenant-display').value.trim();
  const retention_days = parseInt(document.getElementById('new-tenant-retention').value || '90', 10);
  if (!name) { showError('Inserisci un identificativo cliente.'); return; }
  try {
    await api('/_authgate/dashboard/tenants', { method: 'POST', body: JSON.stringify({ name, display_name, retention_days }) });
    document.getElementById('new-tenant-name').value = '';
    document.getElementById('new-tenant-display').value = '';
    showError('');
    loadTenants();
  } catch (e) { showError(e.message); }
}

// --- Ricerca ---
async function runSearch() {
  const tenant = document.getElementById('ricerca-tenant').value;
  const q = document.getElementById('ricerca-query').value || '*';
  const range_minutes = document.getElementById('ricerca-range').value;
  const tbody = document.querySelector('#search-table tbody');
  tbody.innerHTML = '';
  document.getElementById('search-empty').style.display = 'none';
  try {
    const params = new URLSearchParams({ tenant, q, range_minutes });
    const result = await api('/_authgate/dashboard/search?' + params.toString());
    const messages = result.messages || [];
    document.getElementById('search-empty').style.display = messages.length ? 'none' : 'block';
    messages.forEach(m => {
      const tr = document.createElement('tr');
      const ts = m.timestamp || '';
      const host = m.host || '';
      const text = (m.message || '').toString();
      tr.innerHTML = `<td>${ts}</td><td>${host}</td><td class="msg-cell" title="${text.replace(/"/g, '&quot;')}">${text}</td>`;
      tbody.appendChild(tr);
    });
    showError('');
  } catch (e) { showError(e.message); }
}

// --- Allarmi ---
async function loadNotificationsForCheckboxes() {
  const wrap = document.getElementById('allarme-notifiche-list');
  wrap.innerHTML = '<label>Notifiche da collegare</label>';
  try {
    const notifications = await api('/_authgate/dashboard/notifications');
    if (!notifications.length) {
      wrap.innerHTML += '<div class="empty">Nessuna notifica configurata: creane una nella scheda "Notifiche" prima di collegarla a un allarme.</div>';
      return;
    }
    notifications.forEach(n => {
      const id = 'notif-cb-' + n.id;
      const row = document.createElement('div');
      row.className = 'checkbox-row';
      row.innerHTML = `<input type="checkbox" id="${id}" value="${n.id}"><label for="${id}" style="margin:0">${n.title}</label>`;
      wrap.appendChild(row);
    });
  } catch (e) { showError(e.message); }
}

async function loadAlarms() {
  const tenant = document.getElementById('allarme-tenant').value;
  if (!tenant) return;
  try {
    const alarms = await api('/_authgate/dashboard/alarms?tenant=' + encodeURIComponent(tenant));
    const tbody = document.querySelector('#alarms-table tbody');
    tbody.innerHTML = '';
    document.getElementById('alarms-empty').style.display = alarms.length ? 'none' : 'block';
    alarms.forEach(a => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${a.title}</td><td>${(a.config || {}).query || ''}</td>`;
      tbody.appendChild(tr);
    });
  } catch (e) { showError(e.message); }
}

async function createAlarm() {
  const tenant = document.getElementById('allarme-tenant').value;
  const title = document.getElementById('allarme-titolo').value.trim();
  const query = document.getElementById('allarme-query').value || '*';
  const threshold = parseInt(document.getElementById('allarme-soglia').value || '1', 10);
  const window_minutes = parseInt(document.getElementById('allarme-finestra').value || '5', 10);
  const notification_ids = Array.from(document.querySelectorAll('#allarme-notifiche-list input:checked')).map(cb => cb.value);
  if (!title) { showError('Inserisci un titolo per l\'allarme.'); return; }
  try {
    await api('/_authgate/dashboard/alarms', { method: 'POST', body: JSON.stringify({ tenant, title, query, threshold, window_minutes, notification_ids }) });
    document.getElementById('allarme-titolo').value = '';
    showError('');
    loadAlarms();
  } catch (e) { showError(e.message); }
}

// --- Notifiche ---
async function loadNotifications() {
  try {
    const notifications = await api('/_authgate/dashboard/notifications');
    const tbody = document.querySelector('#notifications-table tbody');
    tbody.innerHTML = '';
    document.getElementById('notifications-empty').style.display = notifications.length ? 'none' : 'block';
    notifications.forEach(n => {
      const kind = (n.config || {}).type === 'email-notification-v1' ? 'Email' : 'Webhook';
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${n.title}</td><td>${kind}</td>`;
      tbody.appendChild(tr);
    });
  } catch (e) { showError(e.message); }
}

async function createNotification() {
  const tenant = document.getElementById('notifica-tenant').value;
  const title = document.getElementById('notifica-nome').value.trim();
  const kind = document.getElementById('notifica-tipo').value;
  const target = document.getElementById('notifica-target').value.trim();
  if (!title || !target) { showError('Compila nome e destinazione.'); return; }
  try {
    await api('/_authgate/dashboard/notifications', { method: 'POST', body: JSON.stringify({ tenant, title, kind, target }) });
    document.getElementById('notifica-nome').value = '';
    document.getElementById('notifica-target').value = '';
    showError('');
    loadNotifications();
  } catch (e) { showError(e.message); }
}

// --- Inventario ---
async function loadInventory() {
  const tenant = document.getElementById('inventario-tenant').value;
  if (!tenant) return;
  document.getElementById('inventory-software-detail').style.display = 'none';
  try {
    const hosts = await api('/_authgate/dashboard/inventory?tenant=' + encodeURIComponent(tenant));
    const tbody = document.querySelector('#inventory-table tbody');
    tbody.innerHTML = '';
    document.getElementById('inventory-empty').style.display = hosts.length ? 'none' : 'block';
    hosts.forEach(h => {
      const os = (h.os || {}).name || '?';
      const cpu = h.cpu ? `${h.cpu.model} (${h.cpu.cores} core)` : '?';
      const ram = h.memory ? `${(h.memory.total_mb / 1024).toFixed(1)} GB` : '?';
      const disk = (h.disks && h.disks[0]) ? `${h.disks[0].used_gb} / ${h.disks[0].total_gb} GB` : '-';
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${h.hostname}</td><td>${os}</td><td>${cpu}</td><td>${ram}</td><td>${disk}</td>
        <td><a href="#" onclick="showSoftware('${tenant}','${h.hostname}');return false;">${h.software_count || 0} pacchetti</a></td>
        <td>${h.timestamp || ''}</td>
        <td><a href="/_authgate/dashboard/inventory/export?tenant=${tenant}&hostname=${h.hostname}">PDF</a></td>`;
      tbody.appendChild(tr);
    });
    showError('');
  } catch (e) { showError(e.message); }
}

async function showSoftware(tenant, hostname) {
  try {
    const software = await api('/_authgate/dashboard/inventory/software?tenant=' + encodeURIComponent(tenant) + '&hostname=' + encodeURIComponent(hostname));
    document.getElementById('inventory-software-title').textContent = `Software installato su ${hostname}`;
    const tbody = document.querySelector('#inventory-software-table tbody');
    tbody.innerHTML = '';
    software.forEach(pkg => {
      const tr = document.createElement('tr');
      tr.innerHTML = `<td>${pkg.name}</td><td>${pkg.version || ''}</td>`;
      tbody.appendChild(tr);
    });
    document.getElementById('inventory-software-detail').style.display = 'block';
  } catch (e) { showError(e.message); }
}

// --- Certificati ---
async function loadCertificates() {
  try {
    const certs = await api('/_authgate/dashboard/certificates');
    const tbody = document.querySelector('#certificates-table tbody');
    tbody.innerHTML = '';
    document.getElementById('certificates-empty').style.display = certs.length ? 'none' : 'block';
    certs.forEach(c => {
      const tr = document.createElement('tr');
      const tipo = c.is_server ? 'Server (Graylog)' : 'Client (agent)';
      const stato = c.revoked ? `Revocato il ${c.revoked_at || ''}` : 'Attivo';
      const azione = c.revoked ? '-' :
        `<a href="#" onclick="revokeCertificate('${c.serial_number}');return false;">Revoca</a>`;
      tr.innerHTML = `<td>${c.common_name}</td><td>${tipo}</td><td>${c.issued_at || ''}</td><td>${stato}</td><td>${azione}</td>`;
      tbody.appendChild(tr);
    });
    showError('');
  } catch (e) { showError(e.message); }
}

async function revokeCertificate(serial) {
  if (!confirm('Revocare questo certificato? Segna il certificato come non valido nei registri (vedi nota nel pannello sui limiti di enforcement).')) return;
  try {
    await api(`/_authgate/dashboard/certificates/${serial}/revoke`, { method: 'POST' });
    loadCertificates();
  } catch (e) { showError(e.message); }
}

// --- Avvio ---
loadWhoAmI().catch(() => { window.location.href = '/login.html'; });

// Ricarica gli allarmi quando cambia il cliente selezionato
document.addEventListener('DOMContentLoaded', () => {
  document.getElementById('allarme-tenant').addEventListener('change', loadAlarms);
});
</script>
</body>
</html>
