# ==== Copia questo file in .env e compila TUTTI i valori prima di avviare ====

# --- Dominio pubblico (usato da nginx e dai link generati) ---
PUBLIC_DOMAIN=logs.tuodominio.it

# --- Graylog ---
# Password admin Graylog (interfaccia interna, NON esposta direttamente)
GRAYLOG_ROOT_PASSWORD_SHA2=CAMBIAMI_sha256_della_password
# Segreto usato da Graylog per firmare le sessioni (32+ caratteri random)
GRAYLOG_PASSWORD_SECRET=CAMBIAMI_stringa_random_lunga
GRAYLOG_HTTP_EXTERNAL_URI=http://graylog:9000/
# Credenziali con cui auth-service parla con l'API REST di Graylog per conto
# degli utenti (pannello Clienti/Ricerca/Allarmi/Notifiche). GRAYLOG_API_USER
# di solito e "admin"; GRAYLOG_API_PASSWORD e la password IN CHIARO
# corrispondente all'hash usato sopra in GRAYLOG_ROOT_PASSWORD_SHA2.
GRAYLOG_API_USER=admin
GRAYLOG_API_PASSWORD=CAMBIAMI_stessa_password_in_chiaro_dell_hash_sopra
# Email mittente usata nelle notifiche di allarme create dal pannello
GRAYLOG_ALERT_EMAIL_FROM=alerts@tuodominio.it

# SMTP usato da Graylog per inviare davvero le notifiche email create dal
# pannello. Lascia GRAYLOG_SMTP_HOST vuoto se non ti serve l'invio email.
GRAYLOG_SMTP_ENABLED=false
GRAYLOG_SMTP_HOST=
GRAYLOG_SMTP_PORT=587
GRAYLOG_SMTP_USE_AUTH=true
GRAYLOG_SMTP_USER=
GRAYLOG_SMTP_PASSWORD=
GRAYLOG_SMTP_USE_TLS=true

# --- OpenSearch ---
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# --- MariaDB (utenti/MFA per auth-service) ---
MARIADB_ROOT_PASSWORD=CAMBIAMI
MARIADB_DATABASE=authdb
MARIADB_USER=authuser
MARIADB_PASSWORD=CAMBIAMI

# --- auth-service ---
# Chiave per firmare i cookie di sessione (32+ caratteri random)
AUTH_SECRET_KEY=CAMBIAMI_stringa_random_lunga
DATABASE_URL=mysql+pymysql://authuser:CAMBIAMI@mariadb:3306/authdb
SESSION_COOKIE_NAME=logplatform_session
SESSION_LIFETIME_MINUTES=480

# --- ai-service ---
# Chiave API Anthropic usata per il triage automatico degli allarmi
ANTHROPIC_API_KEY=CAMBIAMI
AI_SERVICE_MODEL=claude-sonnet-4-6
# Token condiviso: Graylog deve inviarlo come header per autenticare la webhook
AI_SERVICE_WEBHOOK_TOKEN=CAMBIAMI_token_random

# --- Backup ---
BACKUP_DIR=/mnt/graylog-data/backups
BACKUP_RETENTION_DAYS=30

# --- Watchdog ---
# URL webhook (es. Slack/Teams/altro) dove notificare i servizi che non ripartono
WATCHDOG_ALERT_WEBHOOK=

# --- Conservazione a norma log amministratori di sistema ---
# (Provvedimento Garante Privacy 27/11/2008) — vedi scripts/provision-admin-log-stream.sh,
# scripts/seal-admin-logs.sh, scripts/verify-admin-log-seal.sh
ADMIN_LOG_RETENTION_DAYS=200
ADMIN_LOG_SEAL_DIR=/mnt/graylog-data/admin-log-seals
OPENSEARCH_URL=http://localhost:9200

# TSA (Time Stamping Authority, RFC 3161) — Namirial (servizio qualificato
# eIDAS a pagamento). Chiedi al supporto Namirial, in fase di attivazione:
#  1. l'URL esatto dell'endpoint TSA/RFC3161 (spesso indicato come
#     "servizio di marcatura temporale" o "TSA" nella loro documentazione)
#  2. il metodo di autenticazione: se Basic Auth, compila TSA_USER/TSA_PASSWORD;
#     se richiedono un certificato client, compila TSA_CLIENT_CERT/TSA_CLIENT_KEY
#     (lascia vuoti i campi del metodo non usato)
#  3. se forniscono un certificato CA per verificare le risposte, salvalo e
#     passalo a verify-admin-log-seal.sh (vedi commenti nello script)
ADMIN_LOG_TSA_URL=
ADMIN_LOG_TSA_USER=
ADMIN_LOG_TSA_PASSWORD=
ADMIN_LOG_TSA_CLIENT_CERT=
ADMIN_LOG_TSA_CLIENT_KEY=
