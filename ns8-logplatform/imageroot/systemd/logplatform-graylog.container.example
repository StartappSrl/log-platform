# Esempio di file "quadlet" (podman >= 4.4 / NS8 recenti) per il container
# Graylog del modulo. Rinomina in logplatform-graylog.container e adatta
# rete/volumi al resto dello scaffold prima dell'uso reale.
[Unit]
Description=Log Platform - Graylog

[Container]
Image=graylog/graylog:6.1
Network=logplatform.network
Volume=logplatform-graylog-data.volume:/usr/share/graylog/data
Volume=%h/logplatform/ca:/etc/graylog/certs:ro
Environment=GRAYLOG_PASSWORD_SECRET=%t/logplatform/secrets/graylog_password_secret
Environment=GRAYLOG_MONGODB_URI=mongodb://logplatform-mongodb:27017/graylog
Environment=GRAYLOG_ELASTICSEARCH_HOSTS=http://logplatform-opensearch:9200

[Service]
Restart=always

[Install]
WantedBy=default.target
